CREATE OR REPLACE TABLE `nyc-trees-homework-2005.2026_2025_all_data_divvy_trip_data.project_data_clean` AS (
  SELECT
    t1.ride_id,
    t1.rideable_type,
    t1.started_at,
    t1.ended_at,
    t1.start_station_name,
    t1.end_station_name,
    t1.member_casual,
    t2.ride_length_in_mins,
    CASE EXTRACT(MONTH FROM t1.started_at)
      WHEN 1 THEN 'January'
      WHEN 2 THEN 'February'
      WHEN 3 THEN 'March'
      WHEN 4 THEN 'April'
      WHEN 5 THEN 'May'
      WHEN 6 THEN 'June'
      WHEN 7 THEN 'July'
      WHEN 8 THEN 'August'
      WHEN 9 THEN 'September'
      WHEN 10 THEN 'October'
      WHEN 11 THEN 'November'
      WHEN 12 THEN 'December'
    END AS month,
    CASE EXTRACT(DAYOFWEEK FROM t1.started_at)
      WHEN 1 THEN 'Sunday'
      WHEN 2 THEN 'Monday'
      WHEN 3 THEN 'Tuesday'
      WHEN 4 THEN 'Wednesday'
      WHEN 5 THEN 'Thursday'
      WHEN 6 THEN 'Friday'
      WHEN 7 THEN 'Saturday'
    END AS day_of_week
  FROM `nyc-trees-homework-2005.2026_2025_all_data_divvy_trip_data.project_data` AS t1
  JOIN (
    SELECT 
      ride_id,
      TIMESTAMP_DIFF(ended_at, started_at, MINUTE) AS ride_length_in_mins
    FROM `nyc-trees-homework-2005.2026_2025_all_data_divvy_trip_data.project_data`
  ) AS t2 ON t1.ride_id = t2.ride_id
  WHERE t1.start_station_name IS NOT NULL 
    AND t1.end_station_name IS NOT NULL 
    AND t1.member_casual IS NOT NULL 
    AND t1.ride_id IS NOT NULL
);
